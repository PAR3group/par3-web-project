 3 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/par3/templates/shop/shop.html b/par3/templates/shop/shop.html
index 74369c9..5a766d6 100644
--- a/par3/templates/shop/shop.html
+++ b/par3/templates/shop/shop.html
@@ -68,10 +68,22 @@
         /* 검색 영역 */
         .search-bar-container {
             display: flex;
-            justify-content: flex-end;
+            justify-content: space-between;
+            align-items: center;
             margin: 25px 0;
         }
 
+        .shop-logo {
+            display: inline-flex;
+            align-items: center;
+            cursor: pointer;
+        }
+
+        .search-bar-right {
+            display: flex;
+            align-items: center;
+        }
+
         .search-bar {
             display: flex;
             gap: 5px;
@@ -332,12 +344,15 @@
     <div class="container">
         <!-- 검색창 -->
         <div class="search-bar-container">
-            {% if g.user and g.user.is_admin %}
-            <a href="{{ url_for('shop.manage_products') }}" class="btn-nav" style="margin-right: 10px;">상품 관리</a>
-            {% endif %}
-            <div class="search-bar">
-                <input type="text" id="searchInput" placeholder="상품검색">
-                <button type="button" id="searchBtn">검색</button>
+            <a href="javascript:void(0)" id="logoContainer" class="shop-logo"></a>
+            <div class="search-bar-right">
+                {% if g.user and g.user.is_admin %}
+                <a href="{{ url_for('shop.manage_products') }}" class="btn-nav" style="margin-right: 10px;">상품 관리</a>
+                {% endif %}
+                <div class="search-bar">
+                    <input type="text" id="searchInput" placeholder="상품검색">
+                    <button type="button" id="searchBtn">검색</button>
+                </div>
             </div>
         </div>
 
