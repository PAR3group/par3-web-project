+{% extends 'base.html' %}
+
+{% block title %}
+PAR3 - 회원 관리
+{% endblock %}
+
+{% block css %}
+<link rel="stylesheet" href="{{ url_for('static', filename='css/admin.css') }}">
+{% endblock %}
+
+{% block content %}
+<div class="a_wrap">
+    <div class="a_head">
+        <h1 class="a_title">회원 관리</h1>
+        <p class="a_subtitle">전체 회원 목록입니다. (총 {{ users|length }}명)</p>
+    </div>
+
+    <div class="a_card">
+        <table class="a_table">
+            <thead>
+                <tr>
+                    <th>ID</th>
+                    <th>아이디</th>
+                    <th>닉네임</th>
+                    <th>이름</th>
+                    <th>이메일</th>
+                    <th>전화번호</th>
+                    <th>골프 경력</th>
+                    <th>구분</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for u in users %}
+                <tr>
+                    <td>{{ u.id }}</td>
+                    <td>{{ u.user_id }}</td>
+                    <td>{{ u.nickname }}</td>
+                    <td>{{ u.username }}</td>
+                    <td>{{ u.email }}</td>
+                    <td>{{ u.phonenumber }}</td>
+                    <td>{{ u.experience_years }}년차</td>
+                    <td>
+                        {% if u.is_admin %}
+                        <span class="a_badge a_badge_admin">관리자</span>
+                        {% else %}
+                        <span class="a_badge">일반회원</span>
