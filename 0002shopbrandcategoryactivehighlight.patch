             gap: 3px;
         }
 
+        /* 브랜드/카테고리 선택(active) */
+        .brand-item,
+        .category-item {
+            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
+        }
+
+        .brand-item:hover .brand-img,
+        .category-item:hover .category-img {
+            transform: translateY(-3px);
+            border-color: #1b4332;
+        }
+
+        .brand-item.active .brand-img {
+            border: 2.5px solid #00ce7c !important;
+            box-shadow: 0 4px 14px rgba(103, 181, 151, 0.25);
+            transform: translateY(-4px) scale(1.02);
+        }
+
+        .brand-item.active .brand-name {
+            color: #1b4332;
+            font-weight: 800;
+        }
+
+        .category-item.active .category-img {
+            border: 2.5px solid #000000 !important;
+            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.25), 0 4px 12px rgba(0, 0, 0, 0.1);
+            transform: scale(1.08);
+        }
+
+        .category-item.active .category-name {
+            color: #1b4332;
+            font-weight: 800;
+        }
